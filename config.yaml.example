# config.yaml
# Central configuration file loaded by every playbook with -e "@config.yaml".
# Adjust versions/ports/credentials here rather than editing individual roles.

elastic_stack_version: "8.15.0"
elasticsearch_heap_size: "1g"
elasticsearch_port: 9200
kibana_port: 5601
logstash_port: 5044

nagios_admin_user: "nagiosadmin"
nagios_admin_password: "CHANGE_ME"
nagios_http_port: 80

influxdb_version: "2.7.6"
influxdb_port: 8086
influxdb_org: "cpe232-org"
influxdb_bucket: "monitoring"
influxdb_admin_user: "admin"
influxdb_admin_password: "CHANGE_ME"

prometheus_version: "2.54.1"
prometheus_port: 9090
# Prometheus needs to know where to scrape metrics from
prometheus_scrape_targets:
  - "{{ hostvars['influxdb-host']['ansible_host'] }}:9100"
  - "{{ hostvars['grafana-host']['ansible_host'] }}:9100"
  - "{{ hostvars['web-host']['ansible_host'] }}:9100"

grafana_version: "11.1.0"
grafana_port: 3000
grafana_admin_user: "admin"
grafana_admin_password: "CHANGE_ME"

php_packages:
  - php
  - libapache2-mod-php
  - php-mysql
  - php-cli

mariadb_root_password: "CHANGE_ME"
mariadb_app_db: "appdb"
mariadb_app_user: "appuser"
mariadb_app_password: "CHANGE_ME"
